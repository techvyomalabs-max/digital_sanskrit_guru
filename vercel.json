{
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ],
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://digital-sanskrit-guru-1-testing.onrender.com/api/:path*"
    },
    {
      "source": "/chatbot-api/:path*",
      "destination": "https://cross-platform-chatbot.ai.vyoma.org/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}